WHISPER_REPO_PATH=~/code/div/whisper.cpp
WHISPER_MODEL_PATH=~/code/div/whisper.cpp/models/ggml-base.en.bin
HOTKEY=<ctrl>+<alt>+<space>
# Optional: whisper language code, e.g. no for Norwegian or auto to detect.
# Leave unset to use whisper's default (English).
# WHISPER_LANGUAGE=no

# Optional: switch language with a hotkey. Each WHISPER_MODEL_PATH_<CODE>
# needs a HOTKEY_<CODE>; <code> is passed to whisper as -l <code>. The model
# above is used until you press one of these.
# WHISPER_MODEL_PATH_EN=~/code/div/whisper.cpp/models/ggml-base.en.bin
# HOTKEY_EN=<ctrl>+<alt>+e
# WHISPER_MODEL_PATH_NO=~/code/div/whisper.cpp/models/ggml-nb-whisper-small.bin
# HOTKEY_NO=<ctrl>+<alt>+n
